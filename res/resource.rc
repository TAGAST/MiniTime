#include "resource.h"
#include <windows.h>

// 应用图标（多尺寸：16/20/24/32/48）
IDI_APP ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MiniTime overlay clock"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "InternalName",    "MiniTime"
            VALUE "OriginalFilename","MiniTime.exe"
            VALUE "ProductName",     "MiniTime"
            VALUE "ProductVersion",  "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
